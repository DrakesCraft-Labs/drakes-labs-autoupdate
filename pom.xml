<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Autocontenido a proposito: NO hereda de drakes-slimefun-labs.
      Este artefacto lo consumen 34 addons ya independizados; mientras su
      descriptor apuntara al monorepo, leerlo exigia el pom del monorepo y
      ningun addon podia hacer `package` por su cuenta.
      La version se mantiene en 11-SNAPSHOT porque es la que ya declaran esos
      34 poms y la que hay publicada en el repositorio local.
    -->
    <groupId>com.github.drakescraft_labs</groupId>
    <artifactId>drakes-labs-autoupdate</artifactId>
    <version>11-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>drakes-labs-autoupdate</name>
    <description>Comprueba GitHub Releases del monorepo y descarga un JAR más nuevo a la carpeta updates/ del servidor.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-artifact</artifactId>
            <version>3.9.16</version>
        </dependency>
    </dependencies>
</project>
